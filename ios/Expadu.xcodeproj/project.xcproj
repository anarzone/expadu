{
  "default-configuration": "Release",
  "configurations": [
    "Debug",
    "Release",
  ],
  "localizations": {
    "development": "en",
    "supported": [
      "Base",
    ],
  },
  "packages": [
    {
      "kind": "local",
      "path": "Packages",
    },
  ],
  "files": [
    { "kind": "folder", "path": "Expadu", "target-membership": [ "Expadu" ] },
    {
      "kind": "group",
      "name": "Products",
      "children": [
        { "path": "<PRODUCTS>/Expadu.app", "id": "000000000000000000000120", "type": "wrapper.application", "index": false },
      ],
    },
  ],
  "targets": [
    {
      "name": "Expadu",
      "id": "000000000000000100000000",
      "product": "Products/Expadu.app",
      "product-type": "application",
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
      ],
      "package-product-members": [
        {
          "package": "Packages",
          "product-name": "Core",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "Packages",
          "product-name": "DesignSystem",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "Packages",
          "product-name": "API",
          "build-phase": { "build-phase": "frameworks" },
        },
      ],
      "build-settings": {
        "ASSETCATALOG_COMPILER_APPICON_NAME": "AppIcon",
        "ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME": "AccentColor",
        "CODE_SIGN_ENTITLEMENTS": "Config/Expadu.entitlements",
        "CODE_SIGN_STYLE": "Automatic",
        "CURRENT_PROJECT_VERSION": "1",
        "ENABLE_PREVIEWS": "YES",
        "GENERATE_INFOPLIST_FILE": "YES",
        "INFOPLIST_FILE": "Config/Expadu-Info.plist",
        "INFOPLIST_KEY_CFBundleDisplayName": "Expadu",
        "INFOPLIST_KEY_LSApplicationCategoryType": "public.app-category.travel",
        "INFOPLIST_KEY_NSLocationWhenInUseUsageDescription": "Expadu shows the departures from the stop closest to you.",
        "INFOPLIST_KEY_NSMicrophoneUsageDescription": "Hold the Composer button and say what you need; Expadu listens only while you hold it.",
        "INFOPLIST_KEY_NSSpeechRecognitionUsageDescription": "Apple’s speech recognition turns what you say into text, so Composer can answer it. Expadu listens only while you hold the button.",
        "INFOPLIST_KEY_UIApplicationSceneManifest_Generation": "YES",
        "INFOPLIST_KEY_UIApplicationSupportsIndirectInputEvents": "YES",
        "INFOPLIST_KEY_UILaunchScreen_Generation": "YES",
        "INFOPLIST_KEY_UISupportedInterfaceOrientations_iPad": "UIInterfaceOrientationPortrait UIInterfaceOrientationPortraitUpsideDown UIInterfaceOrientationLandscapeLeft UIInterfaceOrientationLandscapeRight",
        "INFOPLIST_KEY_UISupportedInterfaceOrientations_iPhone": "UIInterfaceOrientationPortrait",
        "IPHONEOS_DEPLOYMENT_TARGET": "26.0",
        "LD_RUNPATH_SEARCH_PATHS": "@executable_path/Frameworks",
        "MARKETING_VERSION": "0.1",
        "PRODUCT_BUNDLE_IDENTIFIER": "com.expadu.app",
        "PRODUCT_NAME": "$(TARGET_NAME)",
        "SDKROOT": "iphoneos",
        "STRING_CATALOG_GENERATE_SYMBOLS": "YES",
        "SUPPORTED_PLATFORMS": "iphoneos iphonesimulator",
        "SWIFT_APPROACHABLE_CONCURRENCY": "YES",
        "SWIFT_DEFAULT_ACTOR_ISOLATION": "MainActor",
        "SWIFT_EMIT_LOC_STRINGS": "YES",
        "SWIFT_UPCOMING_FEATURE_MEMBER_IMPORT_VISIBILITY": "YES",
        "SWIFT_VERSION": "6.0",
        "TARGETED_DEVICE_FAMILY": "1,2",
      },
    },
  ],
  "build-settings": {
    "ALWAYS_SEARCH_USER_PATHS": "NO",
    "ASSETCATALOG_COMPILER_GENERATE_SWIFT_ASSET_SYMBOL_EXTENSIONS": "YES",
    "CLANG_ENABLE_MODULES": "YES",
    "CLANG_ENABLE_OBJC_ARC": "YES",
    "COPY_PHASE_STRIP": "NO",
    "DEAD_CODE_STRIPPING": "YES",
    "DEBUG_INFORMATION_FORMAT[config=Debug]": "dwarf",
    "DEBUG_INFORMATION_FORMAT[config=Release]": "dwarf-with-dsym",
    "ENABLE_NS_ASSERTIONS[config=Release]": "NO",
    "ENABLE_STRICT_OBJC_MSGSEND": "YES",
    "ENABLE_TESTABILITY[config=Debug]": "YES",
    "ENABLE_USER_SCRIPT_SANDBOXING": "YES",
    "GCC_OPTIMIZATION_LEVEL[config=Debug]": "0",
    "GCC_PREPROCESSOR_DEFINITIONS[config=Debug]": [
      "DEBUG=1",
      "$(inherited)",
    ],
    "LOCALIZATION_PREFERS_STRING_CATALOGS": "YES",
    "ONLY_ACTIVE_ARCH[config=Debug]": "YES",
    "SWIFT_ACTIVE_COMPILATION_CONDITIONS[config=Debug]": "DEBUG LAB $(inherited)",
    "SWIFT_COMPILATION_MODE[config=Release]": "wholemodule",
    "SWIFT_OPTIMIZATION_LEVEL[config=Debug]": "-Onone",
  },
  "last-upgrade": "27.0",
  "last-swift-update": "27.0",
}
