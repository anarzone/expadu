{
    "openapi": "3.1.2",
    "info": {
        "title": "Expadu",
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "https://app.expadu.com/api/v1",
            "description": "Production"
        }
    ],
    "paths": {
        "/me": {
            "get": {
                "operationId": "account.show",
                "tags": [
                    "Account"
                ],
                "responses": {
                    "200": {
                        "description": "`UserResource`",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/UserResource"
                                }
                            }
                        }
                    },
                    "401": {
                        "$ref": "#/components/responses/AuthenticationException"
                    }
                }
            }
        },
        "/me/email-verification": {
            "post": {
                "operationId": "account.resendVerification",
                "tags": [
                    "Account"
                ],
                "responses": {
                    "200": {
                        "description": "",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "sent": {
                                            "type": "boolean"
                                        }
                                    },
                                    "required": [
                                        "sent"
                                    ]
                                }
                            }
                        }
                    },
                    "401": {
                        "$ref": "#/components/responses/AuthenticationException"
                    }
                }
            }
        },
        "/me/deletion-code": {
            "post": {
                "operationId": "account.sendDeletionCode",
                "summary": "For an account without a password: the code that confirms deleting it",
                "tags": [
                    "Account"
                ],
                "responses": {
                    "200": {
                        "description": "",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "sent": {
                                            "type": "boolean"
                                        }
                                    },
                                    "required": [
                                        "sent"
                                    ]
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "An error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "description": "Error overview.",
                                            "examples": [
                                                ""
                                            ]
                                        }
                                    },
                                    "required": [
                                        "message"
                                    ]
                                }
                            }
                        }
                    },
                    "401": {
                        "$ref": "#/components/responses/AuthenticationException"
                    }
                }
            }
        },
        "/me/delete": {
            "post": {
                "operationId": "account.destroy",
                "summary": "Deletes the account for good, with everything ForgetAccount and the web's Delete account remove",
                "tags": [
                    "Account"
                ],
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "allOf": [
                                    {
                                        "$ref": "#/components/schemas/ProfileDeleteRequest"
                                    },
                                    {
                                        "type": "object",
                                        "properties": {
                                            "password": {
                                                "type": "string",
                                                "description": "The password, for an account that has one."
                                            },
                                            "code": {
                                                "type": "string",
                                                "description": "The emailed code, for an account without a password."
                                            }
                                        }
                                    }
                                ]
                            }
                        }
                    }
                },
                "responses": {
                    "204": {
                        "description": "No content"
                    },
                    "401": {
                        "$ref": "#/components/responses/AuthenticationException"
                    },
                    "422": {
                        "$ref": "#/components/responses/ValidationException"
                    }
                }
            }
        },
        "/auth/token": {
            "post": {
                "operationId": "signIn.token",
                "summary": "Email and password. An account with two-step sign-in gets a challenge, not a token",
                "tags": [
                    "SignIn"
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "email": {
                                        "type": "string",
                                        "format": "email"
                                    },
                                    "password": {
                                        "type": "string"
                                    },
                                    "device_name": {
                                        "type": "string",
                                        "maxLength": 255
                                    },
                                    "remember": {
                                        "type": "boolean"
                                    }
                                },
                                "required": [
                                    "email",
                                    "password",
                                    "device_name"
                                ]
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "`SignInResource`",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/SignInResource"
                                }
                            }
                        }
                    },
                    "422": {
                        "$ref": "#/components/responses/ValidationException"
                    }
                }
            },
            "delete": {
                "operationId": "signIn.signOut",
                "tags": [
                    "SignIn"
                ],
                "responses": {
                    "204": {
                        "description": "No content"
                    },
                    "401": {
                        "$ref": "#/components/responses/AuthenticationException"
                    }
                }
            }
        },
        "/auth/two-factor": {
            "post": {
                "operationId": "signIn.twoFactor",
                "summary": "The second step: the app's code, or a recovery code",
                "tags": [
                    "SignIn"
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "challenge": {
                                        "type": "string"
                                    },
                                    "code": {
                                        "type": [
                                            "string",
                                            "null"
                                        ]
                                    },
                                    "recovery_code": {
                                        "type": [
                                            "string",
                                            "null"
                                        ]
                                    }
                                },
                                "required": [
                                    "challenge"
                                ]
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "`SignInResource`",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/SignInResource"
                                }
                            }
                        }
                    },
                    "422": {
                        "$ref": "#/components/responses/ValidationException"
                    }
                }
            }
        },
        "/auth/exchange": {
            "post": {
                "operationId": "signIn.exchange",
                "summary": "Trades the code from Google's sign-in sheet for a token, proving it's the app that asked",
                "tags": [
                    "SignIn"
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "code": {
                                        "type": "string"
                                    },
                                    "verifier": {
                                        "type": "string",
                                        "minLength": 43,
                                        "maxLength": 128
                                    },
                                    "device_name": {
                                        "type": "string",
                                        "maxLength": 255
                                    }
                                },
                                "required": [
                                    "code",
                                    "verifier",
                                    "device_name"
                                ]
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "`SignInResource`",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/SignInResource"
                                }
                            }
                        }
                    },
                    "422": {
                        "$ref": "#/components/responses/ValidationException"
                    }
                }
            }
        },
        "/auth/register": {
            "post": {
                "operationId": "signIn.register",
                "summary": "A new account, signed in, its verification link on the way (as the web's)",
                "tags": [
                    "SignIn"
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "name": {
                                        "type": "string"
                                    },
                                    "email": {
                                        "type": "string",
                                        "format": "email"
                                    },
                                    "password": {
                                        "type": "string"
                                    },
                                    "password_confirmation": {
                                        "type": "string"
                                    },
                                    "device_name": {
                                        "type": "string",
                                        "maxLength": 255
                                    }
                                },
                                "required": [
                                    "name",
                                    "email",
                                    "password",
                                    "password_confirmation",
                                    "device_name"
                                ]
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "`SignInResource`",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/SignInResource"
                                }
                            }
                        }
                    },
                    "422": {
                        "$ref": "#/components/responses/ValidationException"
                    }
                }
            }
        },
        "/auth/forgot-password": {
            "post": {
                "operationId": "signIn.forgotPassword",
                "summary": "Answers the same whether or not the address has an account",
                "tags": [
                    "SignIn"
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "email": {
                                        "type": "string",
                                        "format": "email"
                                    }
                                },
                                "required": [
                                    "email"
                                ]
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "sent": {
                                            "type": "boolean"
                                        }
                                    },
                                    "required": [
                                        "sent"
                                    ]
                                }
                            }
                        }
                    },
                    "422": {
                        "$ref": "#/components/responses/ValidationException"
                    }
                }
            }
        },
        "/auth/refresh": {
            "post": {
                "operationId": "signIn.refresh",
                "summary": "A fresh token for the one making the request, which stops working",
                "tags": [
                    "SignIn"
                ],
                "responses": {
                    "200": {
                        "description": "`SignInResource`",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/SignInResource"
                                }
                            }
                        }
                    },
                    "401": {
                        "$ref": "#/components/responses/AuthenticationException"
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "ProfileDeleteRequest": {
                "type": "object",
                "description": "Deleting the account asks for the password, or, for an account made with\nGoogle that has none, the code just emailed to it (EXP-174).",
                "title": "ProfileDeleteRequest"
            },
            "SignInResource": {
                "type": "object",
                "properties": {
                    "two_factor": {
                        "type": "boolean"
                    },
                    "challenge": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "token": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "expires_at": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "user": {
                        "description": "Left out with a challenge, not null: the Swift generator drops a nullable reference.",
                        "$ref": "#/components/schemas/UserResource"
                    }
                },
                "required": [
                    "two_factor",
                    "challenge",
                    "token",
                    "expires_at"
                ],
                "title": "SignInResource"
            },
            "UserResource": {
                "type": "object",
                "properties": {
                    "name": {
                        "type": "string"
                    },
                    "email": {
                        "type": "string"
                    },
                    "email_verified": {
                        "type": "boolean"
                    },
                    "has_password": {
                        "type": "boolean",
                        "description": "Deleting asks for the password, or an emailed code for an account without one."
                    }
                },
                "required": [
                    "name",
                    "email",
                    "email_verified",
                    "has_password"
                ],
                "title": "UserResource"
            }
        },
        "responses": {
            "ValidationException": {
                "description": "Validation error",
                "content": {
                    "application/json": {
                        "schema": {
                            "type": "object",
                            "properties": {
                                "message": {
                                    "type": "string",
                                    "description": "Errors overview."
                                },
                                "errors": {
                                    "type": "object",
                                    "description": "A detailed description of each field that failed validation.",
                                    "additionalProperties": {
                                        "type": "array",
                                        "items": {
                                            "type": "string"
                                        }
                                    }
                                }
                            },
                            "required": [
                                "message",
                                "errors"
                            ]
                        }
                    }
                }
            },
            "AuthenticationException": {
                "description": "Unauthenticated",
                "content": {
                    "application/json": {
                        "schema": {
                            "type": "object",
                            "properties": {
                                "message": {
                                    "type": "string",
                                    "description": "Error overview."
                                }
                            },
                            "required": [
                                "message"
                            ]
                        }
                    }
                }
            }
        }
    }
}