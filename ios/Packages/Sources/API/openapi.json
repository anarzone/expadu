{
    "openapi": "3.1.2",
    "info": {
        "title": "Expadu",
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "https://app.expadu.com/api/v1",
            "description": "Production"
        }
    ],
    "paths": {
        "/me": {
            "get": {
                "operationId": "account.show",
                "tags": [
                    "Account"
                ],
                "responses": {
                    "200": {
                        "description": "`UserResource`",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/UserResource"
                                }
                            }
                        }
                    },
                    "401": {
                        "$ref": "#/components/responses/AuthenticationException"
                    }
                }
            }
        },
        "/me/email-verification": {
            "post": {
                "operationId": "account.resendVerification",
                "tags": [
                    "Account"
                ],
                "responses": {
                    "200": {
                        "description": "",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "sent": {
                                            "type": "boolean"
                                        }
                                    },
                                    "required": [
                                        "sent"
                                    ]
                                }
                            }
                        }
                    },
                    "401": {
                        "$ref": "#/components/responses/AuthenticationException"
                    }
                }
            }
        },
        "/me/deletion-code": {
            "post": {
                "operationId": "account.sendDeletionCode",
                "summary": "For an account without a password: the code that confirms deleting it",
                "tags": [
                    "Account"
                ],
                "responses": {
                    "200": {
                        "description": "",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "sent": {
                                            "type": "boolean"
                                        }
                                    },
                                    "required": [
                                        "sent"
                                    ]
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "An error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "description": "Error overview.",
                                            "examples": [
                                                ""
                                            ]
                                        }
                                    },
                                    "required": [
                                        "message"
                                    ]
                                }
                            }
                        }
                    },
                    "401": {
                        "$ref": "#/components/responses/AuthenticationException"
                    }
                }
            }
        },
        "/me/delete": {
            "post": {
                "operationId": "account.destroy",
                "summary": "Deletes the account for good, with everything ForgetAccount and the web's Delete account remove",
                "tags": [
                    "Account"
                ],
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "allOf": [
                                    {
                                        "$ref": "#/components/schemas/ProfileDeleteRequest"
                                    },
                                    {
                                        "type": "object",
                                        "properties": {
                                            "password": {
                                                "type": "string",
                                                "description": "The password, for an account that has one."
                                            },
                                            "code": {
                                                "type": "string",
                                                "description": "The emailed code, for an account without a password."
                                            }
                                        }
                                    }
                                ]
                            }
                        }
                    }
                },
                "responses": {
                    "204": {
                        "description": "No content"
                    },
                    "401": {
                        "$ref": "#/components/responses/AuthenticationException"
                    },
                    "422": {
                        "$ref": "#/components/responses/ValidationException"
                    }
                }
            }
        },
        "/auth/token": {
            "post": {
                "operationId": "signIn.token",
                "summary": "Email and password. An account with two-step sign-in gets a challenge, not a token",
                "tags": [
                    "SignIn"
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "email": {
                                        "type": "string",
                                        "format": "email"
                                    },
                                    "password": {
                                        "type": "string"
                                    },
                                    "device_name": {
                                        "type": "string",
                                        "maxLength": 255
                                    },
                                    "remember": {
                                        "type": "boolean"
                                    }
                                },
                                "required": [
                                    "email",
                                    "password",
                                    "device_name"
                                ]
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "`SignInResource`",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/SignInResource"
                                }
                            }
                        }
                    },
                    "422": {
                        "$ref": "#/components/responses/ValidationException"
                    }
                }
            },
            "delete": {
                "operationId": "signIn.signOut",
                "tags": [
                    "SignIn"
                ],
                "responses": {
                    "204": {
                        "description": "No content"
                    },
                    "401": {
                        "$ref": "#/components/responses/AuthenticationException"
                    }
                }
            }
        },
        "/auth/two-factor": {
            "post": {
                "operationId": "signIn.twoFactor",
                "summary": "The second step: the app's code, or a recovery code",
                "tags": [
                    "SignIn"
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "challenge": {
                                        "type": "string"
                                    },
                                    "code": {
                                        "type": [
                                            "string",
                                            "null"
                                        ]
                                    },
                                    "recovery_code": {
                                        "type": [
                                            "string",
                                            "null"
                                        ]
                                    }
                                },
                                "required": [
                                    "challenge"
                                ]
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "`SignInResource`",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/SignInResource"
                                }
                            }
                        }
                    },
                    "422": {
                        "$ref": "#/components/responses/ValidationException"
                    }
                }
            }
        },
        "/auth/exchange": {
            "post": {
                "operationId": "signIn.exchange",
                "summary": "Trades the code from Google's sign-in sheet for a token, proving it's the app that asked",
                "tags": [
                    "SignIn"
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "code": {
                                        "type": "string"
                                    },
                                    "verifier": {
                                        "type": "string",
                                        "minLength": 43,
                                        "maxLength": 128
                                    },
                                    "device_name": {
                                        "type": "string",
                                        "maxLength": 255
                                    }
                                },
                                "required": [
                                    "code",
                                    "verifier",
                                    "device_name"
                                ]
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "`SignInResource`",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/SignInResource"
                                }
                            }
                        }
                    },
                    "422": {
                        "$ref": "#/components/responses/ValidationException"
                    }
                }
            }
        },
        "/auth/apple": {
            "post": {
                "operationId": "signIn.apple",
                "summary": "Sign in with Apple: the sheet's identity token, checked against Apple's keys and the nonce\nthe app made. The same Apple ID always opens the same account; a verified address joins one",
                "tags": [
                    "SignIn"
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "identity_token": {
                                        "type": "string",
                                        "maxLength": 8192
                                    },
                                    "nonce": {
                                        "type": "string",
                                        "minLength": 32,
                                        "maxLength": 128
                                    },
                                    "name": {
                                        "type": [
                                            "string",
                                            "null"
                                        ],
                                        "maxLength": 255
                                    },
                                    "device_name": {
                                        "type": "string",
                                        "maxLength": 255
                                    }
                                },
                                "required": [
                                    "identity_token",
                                    "nonce",
                                    "device_name"
                                ]
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "`SignInResource`",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/SignInResource"
                                }
                            }
                        }
                    },
                    "422": {
                        "$ref": "#/components/responses/ValidationException"
                    }
                }
            }
        },
        "/auth/register": {
            "post": {
                "operationId": "signIn.register",
                "summary": "A new account, signed in, its verification link on the way (as the web's)",
                "tags": [
                    "SignIn"
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "name": {
                                        "type": "string"
                                    },
                                    "email": {
                                        "type": "string",
                                        "format": "email"
                                    },
                                    "password": {
                                        "type": "string"
                                    },
                                    "password_confirmation": {
                                        "type": "string"
                                    },
                                    "device_name": {
                                        "type": "string",
                                        "maxLength": 255
                                    }
                                },
                                "required": [
                                    "name",
                                    "email",
                                    "password",
                                    "password_confirmation",
                                    "device_name"
                                ]
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "`SignInResource`",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/SignInResource"
                                }
                            }
                        }
                    },
                    "422": {
                        "$ref": "#/components/responses/ValidationException"
                    }
                }
            }
        },
        "/auth/forgot-password": {
            "post": {
                "operationId": "signIn.forgotPassword",
                "summary": "Answers the same whether or not the address has an account",
                "tags": [
                    "SignIn"
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "email": {
                                        "type": "string",
                                        "format": "email"
                                    }
                                },
                                "required": [
                                    "email"
                                ]
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "sent": {
                                            "type": "boolean"
                                        }
                                    },
                                    "required": [
                                        "sent"
                                    ]
                                }
                            }
                        }
                    },
                    "422": {
                        "$ref": "#/components/responses/ValidationException"
                    }
                }
            }
        },
        "/auth/refresh": {
            "post": {
                "operationId": "signIn.refresh",
                "summary": "A fresh token for the one making the request, which stops working",
                "tags": [
                    "SignIn"
                ],
                "responses": {
                    "200": {
                        "description": "`SignInResource`",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/SignInResource"
                                }
                            }
                        }
                    },
                    "401": {
                        "$ref": "#/components/responses/AuthenticationException"
                    }
                }
            }
        },
        "/today": {
            "get": {
                "operationId": "today.show",
                "summary": "Today for the iPhone: the same day, notes and ideas the web's Today reads\n(HomeFeedController), in one answer shaped for the app",
                "tags": [
                    "Today"
                ],
                "parameters": [
                    {
                        "name": "lat",
                        "in": "query",
                        "schema": {
                            "type": [
                                "number",
                                "null"
                            ],
                            "minimum": -90,
                            "maximum": 90
                        }
                    },
                    {
                        "name": "lng",
                        "in": "query",
                        "schema": {
                            "type": [
                                "number",
                                "null"
                            ],
                            "minimum": -180,
                            "maximum": 180
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "`TodayResource`",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/TodayResource"
                                }
                            }
                        }
                    },
                    "422": {
                        "$ref": "#/components/responses/ValidationException"
                    },
                    "401": {
                        "$ref": "#/components/responses/AuthenticationException"
                    }
                }
            }
        },
        "/travel/nearby": {
            "get": {
                "operationId": "travel.nearby",
                "summary": "Departures from the stops a short walk from here, soonest first, in KVB's own colours",
                "tags": [
                    "Travel"
                ],
                "parameters": [
                    {
                        "name": "lat",
                        "in": "query",
                        "required": true,
                        "schema": {
                            "type": "number",
                            "minimum": -90,
                            "maximum": 90
                        }
                    },
                    {
                        "name": "lng",
                        "in": "query",
                        "required": true,
                        "schema": {
                            "type": "number",
                            "minimum": -180,
                            "maximum": 180
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "`NearbyDeparturesResource`",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/NearbyDeparturesResource"
                                }
                            }
                        }
                    },
                    "422": {
                        "$ref": "#/components/responses/ValidationException"
                    },
                    "401": {
                        "$ref": "#/components/responses/AuthenticationException"
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "NearbyDeparturesResource": {
                "type": "object",
                "properties": {
                    "stops": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "properties": {
                                "name": {
                                    "type": "string"
                                },
                                "walk_min": {
                                    "type": "integer"
                                }
                            },
                            "required": [
                                "name",
                                "walk_min"
                            ]
                        }
                    },
                    "departures": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "properties": {
                                "line": {
                                    "type": "string"
                                },
                                "direction": {
                                    "type": "string"
                                },
                                "stop": {
                                    "type": "string"
                                },
                                "color": {
                                    "type": "string"
                                },
                                "type": {
                                    "type": "string"
                                },
                                "minutes": {
                                    "type": "array",
                                    "items": {
                                        "type": "integer"
                                    }
                                },
                                "delay": {
                                    "type": "integer"
                                },
                                "cancelled": {
                                    "type": "boolean"
                                },
                                "disrupted": {
                                    "type": "boolean"
                                }
                            },
                            "required": [
                                "line",
                                "direction",
                                "stop",
                                "color",
                                "type",
                                "minutes",
                                "delay",
                                "cancelled",
                                "disrupted"
                            ]
                        }
                    }
                },
                "required": [
                    "stops",
                    "departures"
                ],
                "title": "NearbyDeparturesResource"
            },
            "ProfileDeleteRequest": {
                "type": "object",
                "description": "Deleting the account asks for the password, or, for an account made with\nGoogle that has none, the code just emailed to it (EXP-174).",
                "title": "ProfileDeleteRequest"
            },
            "SignInResource": {
                "type": "object",
                "properties": {
                    "two_factor": {
                        "type": "boolean"
                    },
                    "challenge": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "token": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "expires_at": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "user": {
                        "description": "Left out with a challenge, not null: the Swift generator drops a nullable reference.",
                        "$ref": "#/components/schemas/UserResource"
                    }
                },
                "required": [
                    "two_factor",
                    "challenge",
                    "token",
                    "expires_at"
                ],
                "title": "SignInResource"
            },
            "TodayResource": {
                "type": "object",
                "properties": {
                    "date": {
                        "type": "string"
                    },
                    "now": {
                        "type": "string"
                    },
                    "weather": {
                        "type": [
                            "object",
                            "null"
                        ],
                        "properties": {
                            "temperature": {
                                "type": "integer"
                            },
                            "condition": {
                                "type": "string"
                            },
                            "icon": {
                                "type": "string"
                            }
                        },
                        "required": [
                            "temperature",
                            "condition",
                            "icon"
                        ]
                    },
                    "plans": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "properties": {
                                "id": {
                                    "type": "string"
                                },
                                "title": {
                                    "type": "string"
                                },
                                "subtitle": {
                                    "type": [
                                        "string",
                                        "null"
                                    ]
                                },
                                "start_time": {
                                    "type": [
                                        "string",
                                        "null"
                                    ]
                                },
                                "end_time": {
                                    "type": [
                                        "string",
                                        "null"
                                    ]
                                },
                                "place": {
                                    "type": [
                                        "string",
                                        "null"
                                    ]
                                },
                                "state": {
                                    "type": "string"
                                },
                                "completed": {
                                    "type": "boolean"
                                }
                            },
                            "required": [
                                "id",
                                "title",
                                "subtitle",
                                "start_time",
                                "end_time",
                                "place",
                                "state",
                                "completed"
                            ]
                        }
                    },
                    "leave": {
                        "type": [
                            "object",
                            "null"
                        ],
                        "properties": {
                            "to": {
                                "type": "string"
                            },
                            "start_time": {
                                "type": [
                                    "string",
                                    "null"
                                ]
                            },
                            "status": {
                                "type": "string"
                            },
                            "leave_time": {
                                "type": [
                                    "string",
                                    "null"
                                ]
                            },
                            "leave_in_min": {
                                "type": [
                                    "integer",
                                    "null"
                                ]
                            },
                            "arrive_time": {
                                "type": [
                                    "string",
                                    "null"
                                ]
                            },
                            "spare_min": {
                                "type": [
                                    "integer",
                                    "null"
                                ]
                            },
                            "line": {
                                "type": [
                                    "string",
                                    "null"
                                ]
                            },
                            "color": {
                                "type": [
                                    "string",
                                    "null"
                                ]
                            },
                            "departs": {
                                "type": [
                                    "string",
                                    "null"
                                ]
                            },
                            "from": {
                                "type": [
                                    "string",
                                    "null"
                                ]
                            },
                            "live": {
                                "type": "boolean"
                            }
                        },
                        "required": [
                            "to",
                            "start_time",
                            "status",
                            "leave_time",
                            "leave_in_min",
                            "arrive_time",
                            "spare_min",
                            "line",
                            "color",
                            "departs",
                            "from",
                            "live"
                        ]
                    },
                    "needs": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "properties": {
                                "id": {
                                    "type": "string"
                                },
                                "kind": {
                                    "type": "string"
                                },
                                "severity": {
                                    "type": "string"
                                },
                                "headline": {
                                    "type": "string"
                                },
                                "detail": {
                                    "type": [
                                        "string",
                                        "null"
                                    ]
                                }
                            },
                            "required": [
                                "id",
                                "kind",
                                "severity",
                                "headline",
                                "detail"
                            ]
                        }
                    },
                    "ideas": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "properties": {
                                "id": {
                                    "type": "integer"
                                },
                                "title": {
                                    "type": "string"
                                },
                                "meta": {
                                    "type": "string"
                                },
                                "category": {
                                    "type": "string"
                                },
                                "emoji": {
                                    "type": [
                                        "string",
                                        "null"
                                    ]
                                },
                                "starts_at": {
                                    "type": [
                                        "string",
                                        "null"
                                    ]
                                },
                                "price": {
                                    "type": [
                                        "string",
                                        "null"
                                    ]
                                },
                                "place": {
                                    "type": [
                                        "string",
                                        "null"
                                    ]
                                },
                                "area": {
                                    "type": [
                                        "string",
                                        "null"
                                    ]
                                }
                            },
                            "required": [
                                "id",
                                "title",
                                "meta",
                                "category",
                                "emoji",
                                "starts_at",
                                "price",
                                "place",
                                "area"
                            ]
                        }
                    },
                    "ideas_part": {
                        "type": "string"
                    },
                    "tomorrow": {
                        "type": "object",
                        "properties": {
                            "date": {
                                "type": [
                                    "string",
                                    "null"
                                ]
                            },
                            "plans": {
                                "type": "array",
                                "items": {
                                    "type": "object",
                                    "properties": {
                                        "title": {
                                            "type": "string"
                                        },
                                        "place": {
                                            "type": [
                                                "string",
                                                "null"
                                            ]
                                        },
                                        "start": {
                                            "type": [
                                                "string",
                                                "null"
                                            ]
                                        }
                                    },
                                    "required": [
                                        "title",
                                        "place",
                                        "start"
                                    ]
                                }
                            }
                        },
                        "required": [
                            "date",
                            "plans"
                        ]
                    }
                },
                "required": [
                    "date",
                    "now",
                    "weather",
                    "plans",
                    "leave",
                    "needs",
                    "ideas",
