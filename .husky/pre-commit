#!/bin/bash

# Pre-commit hook for Expadu
# Runs Pint (PHP) + Prettier (JS/TS) on staged files only

set -e

echo "🔍 Running pre-commit checks..."
echo ""

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

run_check() {
    local name=$1
    local command=$2
    echo -e "${YELLOW}▶ Running $name...${NC}"
    if eval "$command"; then
        echo -e "${GREEN}✓ $name passed${NC}"
        echo ""
        return 0
    else
        echo -e "${RED}✗ $name failed${NC}"
        echo ""
        return 1
    fi
}

# Secret scan FIRST — catch a hardcoded credential before it's ever committed,
# and fail fast (before the slower Pint/test steps). Scans only staged changes.
echo -e "${YELLOW}▶ Running Secret Scan (gitleaks)...${NC}"
if command -v gitleaks >/dev/null 2>&1; then
    if gitleaks git --staged --redact --no-banner; then
        echo -e "${GREEN}✓ Secret Scan (gitleaks) passed${NC}"
        echo ""
    else
        echo -e "${RED}✗ Secret Scan failed — a secret was found in your staged changes.${NC}"
        echo -e "${RED}  Remove it (use \${{ secrets.* }} in CI, .env locally), then re-commit.${NC}"
        echo -e "${YELLOW}  False positive? append a 'gitleaks:allow' comment on the line, or add it to .gitleaksignore.${NC}"
        exit 1
    fi
else
    echo -e "${RED}⚠ gitleaks NOT installed — secret scan SKIPPED.${NC}"
    echo -e "${YELLOW}  Install it so leaks are caught locally:  brew install gitleaks${NC}"
    echo ""
fi

# Formatting runs through lint-staged for BOTH languages, which is the only
# part of this that re-stages what it rewrites.
#
# Pint used to run separately as `pint --dirty`, and that was wrong twice over:
# it never `git add`-ed its own fixes, so the UNFORMATTED version was what got
# committed while the fix sat in the working tree (caught five times in one
# day, each needing a --amend); and `--dirty` means "every file with
# uncommitted changes", so it also rewrote unrelated work-in-progress the
# author had deliberately left unstaged.
#
# lint-staged stashes unstaged changes, passes only the staged paths, and
# re-stages the result — including for a file that is only partially staged.
run_check "Format staged files (Pint + Prettier)" "npx lint-staged"

# No test suite here. Tests, lint, the frontend tests and the browser specs run on
# GitHub for every PR into main, staging and the launch branch (.github/workflows/ci.yml),
# so a commit stays quick on a machine shared by several sessions (owner, 21 Oct 2026).
# Before pushing, run the tests for what you changed, e.g. `php artisan test --filter=…`.

echo -e "${GREEN}✅ All checks passed!${NC}"
echo "Proceeding with commit..."
