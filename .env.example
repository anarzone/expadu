APP_NAME=Expadu
APP_ENV=local
APP_COMMIT=
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Subdomain routing (production: APP_DOMAIN=app.expadu.com, MARKETING_DOMAIN=expadu.com)
# Leave empty for local dev — no subdomain enforcement
APP_DOMAIN=
MARKETING_DOMAIN=
FORTIFY_HOME=/today

# Optional localhost-only review entry at /dev/review. Existing non-admin test account only.
LOCAL_REVIEW_ENABLED=false
LOCAL_REVIEW_EMAIL=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=expadu
DB_USERNAME=sail
DB_PASSWORD=password
# Reuse Postgres connections across PHP-FPM requests (EXP-87). Staging first.
DB_PERSISTENT=false

# Session/Cache/Queue — use 'redis' for production, 'database' for dev
SESSION_DRIVER=database
# Idle minutes before a session expires (30 days). "Remember me" outlives it.
SESSION_LIFETIME=43200
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Inertia's history encryption (config/inertia.php): keep it on; it needs https
# or localhost, so only a plain-http local preview (a phone on the LAN) sets false.
INERTIA_ENCRYPT_HISTORY=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
# Optional: a separate, evicting Redis for the cache (EXP-95). Unset = same instance, DB 1.
# REDIS_CACHE_HOST=127.0.0.1
# Share of request timings PerfLogger keeps (perf:report).
PERF_SAMPLE_RATE=0.25

# Mail — use 'smtp' or 'resend' for production
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@expadu.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Social login (Google & Apple OAuth)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=${APP_URL}/auth/google/callback
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_REDIRECT_URI=${APP_URL}/auth/apple/callback

# Routing — self-hosted MOTIS is enabled on staging/production. Leave it empty
# locally so Transitous is used directly instead of probing the Laravel server.
MOTIS_URL=
TRANSITOUS_URL=https://api.transitous.org

# VRS real-time transit data — requires client certificate from VRS
VRS_REALTIME_ENABLED=false
VRS_GTFSRT_URL=
VRS_TRIAS_URL=
VRS_CLIENT_CERT=
VRS_CLIENT_CERT_PASSWORD=

# Claude API. Use a key from a dedicated Expadu workspace in the Console,
# with a spend limit. Event classification/translation stays dormant unless
# EVENTS_CLASSIFICATION_ENABLED is explicitly enabled.
EVENTS_CLASSIFICATION_ENABLED=false
# Scheduled place imports and photo acquisition stay off until target data is qualified.
PLACES_AUTOMATION_ENABLED=false
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
ANTHROPIC_EFFORT=low

# English briefs for KVB notices (public data; uses ANTHROPIC_API_KEY).
TRANSIT_BRIEFS_ENABLED=true
TRANSIT_BRIEFS_DAILY_LIMIT=300

# Nightly taste profiles for people who opted in to personalisation (uses ANTHROPIC_API_KEY).
TASTE_PROFILE_ENABLED=false
TASTE_PROFILE_DAILY_LIMIT=500

# Grounded Composer ranking — disabled keeps the deterministic planner only.
# COMPOSER_LLM_KEY falls back to ANTHROPIC_API_KEY when left empty.
COMPOSER_LLM_ENABLED=false
COMPOSER_LLM_KEY=
COMPOSER_LLM_MODEL=claude-haiku-5-5
COMPOSER_LLM_EFFORT=low
COMPOSER_LLM_TIMEOUT=8

# Composer's assistant answers with Claude when set to "anthropic"; otherwise
# Composer says its AI is off and shows what's on. Uses ANTHROPIC_API_KEY unless LLM_KEY is set.
LLM_DRIVER=heuristic

# Optional bounded bureaucracy fact interpreter (Claude). Each request still
# needs the person's consent; the key falls back to ANTHROPIC_API_KEY.
BUREAUCRACY_LLM_ENABLED=false
BUREAUCRACY_LLM_KEY=
BUREAUCRACY_LLM_TIMEOUT=8
# A per-person daily cap on these requests: none unless set (owner, 22 Oct 2026).
# BUREAUCRACY_LLM_DAILY_LIMIT=

# Sentry error tracking — get DSN from sentry.io project settings.
# The VITE_* vars are read at BUILD time, so they must be present when the
# frontend is compiled (in CI / on the box), not just at runtime.
# Set SENTRY_ENVIRONMENT per box (staging|production); it falls back to APP_ENV.
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_ENVIRONMENT=
VITE_SENTRY_DSN_PUBLIC=
VITE_SENTRY_ENVIRONMENT=
VITE_SENTRY_RELEASE=

# Web Push (VAPID) — generate at https://vapidkeys.com
VAPID_SUBJECT=mailto:hello@expadu.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Street-level photos (Mapillary, CC BY-SA 4.0, free for commercial use).
# Free client token: mapillary.com/dashboard/developers. Unset = command no-ops.
# Attribution is mandatory wherever these images are shown.
MAPILLARY_TOKEN= # gitleaks:allow — empty placeholder, no secret here
MAPILLARY_RADIUS=30
MAPILLARY_MAX_BEARING_OFFSET=40
