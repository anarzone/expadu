APP_NAME=Expadu
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Subdomain routing (production: APP_DOMAIN=app.expadu.com, MARKETING_DOMAIN=expadu.com)
# Leave empty for local dev — no subdomain enforcement
APP_DOMAIN=
MARKETING_DOMAIN=
FORTIFY_HOME=/dashboard

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=expadu
DB_USERNAME=sail
DB_PASSWORD=password

# Session/Cache/Queue — use 'redis' for production, 'database' for dev
SESSION_DRIVER=database
SESSION_LIFETIME=525600
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail — use 'smtp' or 'resend' for production
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@expadu.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Social login (Google & Apple OAuth)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=${APP_URL}/auth/google/callback
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_REDIRECT_URI=${APP_URL}/auth/apple/callback

# Routing — self-hosted MOTIS is primary; Transitous is the failover provider.
MOTIS_URL=http://localhost:8080
TRANSITOUS_URL=https://api.transitous.org

# VRS real-time transit data — requires client certificate from VRS
VRS_REALTIME_ENABLED=false
VRS_GTFSRT_URL=
VRS_TRIAS_URL=
VRS_CLIENT_CERT=
VRS_CLIENT_CERT_PASSWORD=

# Grounded Composer ranking — disabled keeps the deterministic planner only.
# COMPOSER_LLM_KEY falls back to ANTHROPIC_API_KEY when left empty.
ANTHROPIC_API_KEY=
COMPOSER_LLM_ENABLED=false
COMPOSER_LLM_KEY=
COMPOSER_LLM_MODEL=claude-sonnet-5
COMPOSER_LLM_TIMEOUT=8

# Optional bounded bureaucracy fact interpreter. Disabled until the dedicated
# provider key and processor disclosure are configured.
BUREAUCRACY_LLM_ENABLED=false
BUREAUCRACY_LLM_BASE_URL=https://api.deepseek.com/beta
BUREAUCRACY_LLM_MODEL=deepseek-v4-flash
BUREAUCRACY_LLM_KEY=
BUREAUCRACY_LLM_PROCESSOR_NAME=
BUREAUCRACY_LLM_PROCESSOR_PRIVACY_URL=
BUREAUCRACY_LLM_TIMEOUT=8
BUREAUCRACY_LLM_PROMPT_VERSION=2026-08-04
BUREAUCRACY_LLM_DAILY_LIMIT=20

# Sentry error tracking — get DSN from sentry.io project settings.
# The VITE_* vars are read at BUILD time, so they must be present when the
# frontend is compiled (in CI / on the box), not just at runtime.
# Set SENTRY_ENVIRONMENT per box (staging|production); it falls back to APP_ENV.
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_ENVIRONMENT=
VITE_SENTRY_DSN_PUBLIC=
VITE_SENTRY_ENVIRONMENT=
VITE_SENTRY_RELEASE=

# Web Push (VAPID) — generate at https://vapidkeys.com
VAPID_SUBJECT=mailto:hello@expadu.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
