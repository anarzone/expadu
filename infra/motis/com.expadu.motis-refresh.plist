<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Weekly MOTIS timetable refresh (Mondays 05:00; launchd catches up after sleep).
     Install: see infra/motis/README.md, "Weekly refresh". __HOME__ is replaced on install. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.expadu.motis-refresh</string>
  <key>ProgramArguments</key>
  <array><string>/bin/bash</string><string>__HOME__/motis-bench/refresh.sh</string></array>
  <key>EnvironmentVariables</key>
  <dict><key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string></dict>
  <key>StartCalendarInterval</key>
  <dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>5</integer><key>Minute</key><integer>0</integer></dict>
  <key>StandardOutPath</key><string>__HOME__/motis-bench/refresh.log</string>
  <key>StandardErrorPath</key><string>__HOME__/motis-bench/refresh.log</string>
</dict>
</plist>
