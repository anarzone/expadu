{
    "name": "travel-leave-now",
    "clock": "2026-09-30T13:10:00+02:00",
    "widths": [
        360,
        390,
        768,
        1280,
        1440,
        1512
    ],
    "height": 900,
    "tolerance": 0.5,
    "mock": {
        "url": "/dev/design/departures-next/",
        "wait": "#next-trip .trip-line-row"
    },
    "app": {
        "url": "/timetable",
        "wait": "#departures > .trip-line .trip-line-row",
        "init": [
            "document.cookie = 'mock_clock=2026-09-30T13:10:00%2B02:00; path=/'"
        ],
        "login": {
            "email": "e2e@expadu.test",
            "password": "e2e-password"
        }
    },
    "pairs": [
        {"name": "Leave now card", "mock": "#departures > .trip-line", "app": "#departures > .trip-line"},
        {"name": "card row", "mock": "#departures > .trip-line .trip-line-row", "app": "#departures > .trip-line .trip-line-row"},
        {"name": "ring", "mock": "#departures > .trip-line .trip-ring", "app": "#departures > .trip-line .trip-ring"},
        {"name": "ring time", "mock": "#departures > .trip-line .trip-ring strong", "app": "#departures > .trip-line .trip-ring strong"},
        {"name": "title", "mock": "#departures > .trip-line .trip-title strong", "app": "#departures > .trip-line .trip-title strong"},
        {"name": "plan and time", "mock": "#departures > .trip-line .trip-title span", "app": "#departures > .trip-line .trip-title span"},
        {"name": "facts", "mock": "#departures > .trip-line .trip-facts", "app": "#departures > .trip-line .trip-facts"},
        {"name": "fact: the ride", "mock": "#departures > .trip-line .trip-fact", "app": "#departures > .trip-line .trip-fact", "index": 0},
        {"name": "fact: there", "mock": "#departures > .trip-line .trip-fact", "app": "#departures > .trip-line .trip-fact", "index": 1},
        {"name": "fact: spare", "mock": "#departures > .trip-line .trip-fact", "app": "#departures > .trip-line .trip-fact", "index": 2},
        {"name": "fact label", "mock": "#departures > .trip-line .trip-fact-label", "app": "#departures > .trip-line .trip-fact-label", "index": 1},
        {"name": "fact value", "mock": "#departures > .trip-line .trip-fact strong", "app": "#departures > .trip-line .trip-fact strong", "index": 1},
        {"name": "fact sub", "mock": "#departures > .trip-line .trip-fact small", "app": "#departures > .trip-line .trip-fact small", "index": 1},
        {"name": "ride badge", "mock": "#departures > .trip-line .trip-fact .tl-line", "app": "#departures > .trip-line .trip-fact .tl-line"},
        {"name": "too-tight note", "mock": "#departures > .trip-line .trip-plan", "app": "#departures > .trip-line .trip-plan"},
        {"name": "I'm on my way", "mock": "#departures > .trip-line .next-trip-go", "app": "#departures > .trip-line .next-trip-go"},
        {"name": "show the way toggle", "mock": "#departures > .trip-line .trip-line-more", "app": "#departures > .trip-line .trip-line-more"}
    ]
}
